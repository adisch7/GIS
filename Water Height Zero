import arcpy

arcpy.env.overwriteOutput = True
arcpy.CheckOutExtension("Spatial")
arcpy.CheckOutExtension("ImageAnalyst")
arcpy.CheckOutExtension("3D")
# ----------------------------------------------------------------------------------------------------------------------
vector_layer = arcpy.GetParameterAsText(0)  # Flow layer
rsater_layer = arcpy.GetParameterAsText(1)  # DTM raster

flow = arcpy.MakeFeatureLayer_management(vector_layer, 'test')
dtm = arcpy.MakeRasterLayer_management(rsater_layer, 'DTM')

with arcpy.da.UpdateCursor(flow, ["SHAPE@"]) as cursor:
    for row in cursor:
        shape = row[0]
        list_point =[]
        if len(shape.getPart()) == 1:
            for part in shape:

                for pnt in part:
                    x = pnt.X
                    y = pnt.Y
                    cell_value = arcpy.GetCellValue_management(dtm, "{0} {1}".format(x,y))
                    z_value = 0
                    if  not  u'NoData'  ==cell_value.getOutput(0):
                        z_value = float(cell_value.getOutput(0))
                    list_point.append(arcpy.Point (x ,y, z_value ) )
            shape  = arcpy.Polyline(arcpy.Array(list_point), shape.spatialReference, True)
            cursor.updateRow([shape])
del cursor
del row



